# LLM 配置（必填）
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1

# 联网搜索（推荐；未配置时降级到 DDGS）
TAVILY_API_KEY=tvly-your-api-key-here

# 搜索缓存与网页读取限制
SEARCH_CACHE_TTL_SECONDS=3600

# Claim-Evidence independent judge (optional; rules run when unset)
EVAL_JUDGE_API_KEY=
EVAL_JUDGE_MODEL=
EVAL_JUDGE_BASE_URL=
WEB_REQUEST_TIMEOUT=12
MAX_PAGE_CHARS=12000

# 会话 Checkpoint（网页服务默认 SQLite，服务重启后可恢复）
CHECKPOINT_BACKEND=sqlite
CHECKPOINT_SQLITE_PATH=.data/checkpoints.sqlite3
SESSION_CATALOG_SQLITE_PATH=.data/sessions.sqlite3

# 可选：按每 1K token 配置模型价格，用于估算本次研究成本
LLM_INPUT_COST_PER_1K=
LLM_OUTPUT_COST_PER_1K=

# 同时运行的研究任务上限；同一 session 始终只允许一个任务
MAX_CONCURRENT_RESEARCH=5
SESSION_RATE_LIMIT_PER_MINUTE=10
MAX_MESSAGE_CHARS=5000
CONTEXT_TOKEN_BUDGET=24000
ROUTING_LLM_ENABLED=false
RUN_STORE_SQLITE_PATH=.data/runs.sqlite3
RUN_STORE_BACKEND=sqlite
EXECUTION_BACKEND=local
MYSQL_DSN=mysql+asyncmy://industry:industry@localhost:3306/industry_agent
MYSQL_POOL_SIZE=10
MYSQL_MAX_OVERFLOW=20
REDIS_URL=redis://localhost:6379/0
REDIS_TASK_STREAM=research:tasks
REDIS_CONSUMER_GROUP=industry-agent-workers
REDIS_CONSUMER_NAME=
REDIS_EVENT_RETENTION=1000
REDIS_CLAIM_IDLE_MS=60000
ARTIFACT_STORE_PATH=.data/artifacts
PRIVATE_RAG_SQLITE_PATH=.data/private_rag.sqlite3
PRIVATE_RAG_SOURCE_ROOT=.data/private_docs
PRIVATE_RAG_MAX_UPLOAD_BYTES=20971520
PRIVATE_RAG_ENABLED=false
PRIVATE_RAG_RETRIEVAL=tfidf
PRIVATE_RAG_VECTOR_PATH=.data/private_rag.chroma
PRIVATE_RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
PRIVATE_RAG_RERANK=false
PRIVATE_RAG_RERANKER_MODEL=BAAI/bge-reranker-base
PRIVATE_RAG_SOURCE_ROOT=.data/private_docs
RUN_TIMEOUT_SECONDS=300
WORKER_LEASE_SECONDS=45
RUNTIME_LOG_PATH=.data/runtime.jsonl
USER_MEMORY_SQLITE_PATH=.data/user_memory.sqlite3
